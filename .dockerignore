# Lo que NO entra en la imagen. Mantiene el build rápido y evita copiar secretos.

# Git y configuración local
.git
.gitignore
.gitattributes
.claude
.vscode
.idea

# Secretos: nunca dentro de una imagen
.env
.env.*
**/.npmrc

# Entorno y artefactos de Python
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache

# Generados y documentación (no los necesita la app)
graphify-out
docs
*.md

# Archivos de Docker
Dockerfile
compose.yaml
.dockerignore
